.DS_Store
.idea/
.vscode/
*.log
node_modules/

# Tool/agent artefacts (not part of the repo)
.playwright-mcp/
repo-structure.md

# fwd:setup:gitignore:start (managed by /fwd:setup — do not edit manually)
# fwd:mission-run / fwd:steps-run worktrees. Without .trees/ gitignored,
# preflight rejects every tick on a clean repo because the worktree it
# just created shows up as untracked.
.trees/

# Claude Code /loop scheduling state. Recreated on every ScheduleWakeup,
# so it permanently dirties the tree unless ignored.
.claude/scheduled_tasks.lock
tmp/
# fwd:setup:gitignore:end
