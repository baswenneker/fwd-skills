        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/productivity/idle-summary/scripts/prompt.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
